{
  "name": "@skirm/fhevm",
  "version": "0.1.0",
  "private": true,
  "description": "skirm confidential contracts on the Zama Protocol (FHEVM): ERC-7984 credits and game state.",
  "license": "MIT",
  "exports": {
    "./generated": "./generated/index.ts"
  },
  "scripts": {
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "test": "hardhat test",
    "typecheck": "npm run compile && tsc --noEmit",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "export": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat run scripts/export.ts",
    "clean": "rimraf ./artifacts ./cache ./types ./fhevmTemp"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  }
}
