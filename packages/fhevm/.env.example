# Copy to packages/fhevm/.env (git-ignored). Never commit real keys.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
# Optional: verify on Etherscan with `npx hardhat verify --network sepolia <address> <args...>`
ETHERSCAN_API_KEY=
# Optional deploy parameters for ConfidentialSkirmCredits
CREDITS_OWNER=
FAUCET_AMOUNT=1000000000
FAUCET_COOLDOWN_SECONDS=86400
