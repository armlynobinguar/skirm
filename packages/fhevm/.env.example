# Copy to packages/fhevm/.env (git-ignored). Never commit real keys.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
# Optional: verify on Etherscan with `npx hardhat verify --network sepolia <address> <args...>`
ETHERSCAN_API_KEY=
# Optional deploy parameters for ConfidentialSkirmCredits
CREDITS_OWNER=
FAUCET_AMOUNT=1000000000
FAUCET_COOLDOWN_SECONDS=86400
# Optional deploy parameters for SkirmMatch (stake escrow). MATCH_OPERATOR defaults to the deployer:
# the game server settles results with that account's key (ZAMA_OPERATOR_PRIVATE_KEY on the server).
# CREDITS_ADDRESS defaults to the cSKIRM in deployments/<network>.json (or the one deployed in the same run).
CREDITS_ADDRESS=
MATCH_OPERATOR=
TREASURY=
FEE_BPS=0
# FogSkirm (/fog) takes no constructor arguments: add it with DEPLOY_CONTRACTS=FogSkirm.
# SkillAuction (sealed-bid skill auctions on the Exchange): add it with DEPLOY_CONTRACTS=SkillAuction.
# Uses CREDITS_ADDRESS and TREASURY as above; AUCTION_FEE_BPS is the fee on the clearing price
# (0..1000, defaults to FEE_BPS).
AUCTION_FEE_BPS=
# BenchmarkSeeds (hidden benchmark seeds drawn on chain): add it with DEPLOY_CONTRACTS=BenchmarkSeeds.
# BENCHMARK_OPERATOR commits and publishes the seeds (defaults to MATCH_OPERATOR, else the deployer;
# the worker holds its key as ZAMA_OPERATOR_PRIVATE_KEY). BENCHMARK_REVEAL_WINDOW_SECONDS is how long
# it has to publish before anyone may force the reveal (600..2592000, default 86400).
BENCHMARK_OPERATOR=
BENCHMARK_REVEAL_WINDOW_SECONDS=86400
# MatchPredictions (confidential spectator predictions): add it with DEPLOY_CONTRACTS=MatchPredictions.
# Uses CREDITS_ADDRESS and TREASURY as above, and the SkirmMatch in deployments/<network>.json (or
# SKIRM_MATCH_ADDRESS) to read sealed matches' winners. PREDICTIONS_OPERATOR opens, closes and
# resolves markets (defaults to MATCH_OPERATOR, else the deployer; the realtime server holds its key
# as ZAMA_OPERATOR_PRIVATE_KEY). PREDICTIONS_FEE_BPS is the fee on the winnings (0..1000, defaults
# to FEE_BPS).
SKIRM_MATCH_ADDRESS=
PREDICTIONS_OPERATOR=
PREDICTIONS_FEE_BPS=
# PrivateLadder (private MMR: encrypted ratings, public tiers): add it with DEPLOY_CONTRACTS=PrivateLadder.
# Uses the SkirmMatch in deployments/<network>.json (or SKIRM_MATCH_ADDRESS) for sealed matches.
# LADDER_OPERATOR reports ranked matches and asks isCloseMatch (defaults to MATCH_OPERATOR, else the
# deployer; the realtime server holds its key as ZAMA_OPERATOR_PRIVATE_KEY). LADDER_MATCH_WINDOW is
# the rating gap isCloseMatch calls close (25..1000, default 200).
LADDER_OPERATOR=
LADDER_MATCH_WINDOW=200
