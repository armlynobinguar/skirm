{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": [
    "./hardhat.config.ts"
  ],
  "include": [
    "scripts/**/*",
    "test/**/*",
    "types/**/*",
    "generated/**/*"
  ],
  "exclude": [
    "node_modules"
  ],
  "ts-node": {
    "moduleTypes": {
      "../shared/src/fog-skirm.ts": "cjs",
      "../shared/src/sealed-auction.ts": "cjs",
      "../shared/src/benchmark-seeds.ts": "cjs",
      "../shared/src/match-predictions.ts": "cjs"
    }
  }
}
