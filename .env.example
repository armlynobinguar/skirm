# skirm environment (docs/backend-contract.md, Environment). Copy to .env and edit.
# Read by api, worker and realtime through @skirm/server loadConfig(). An empty value means unset.
# docker-compose.yml sets its own in-network values for DATABASE_URL and REDIS_URL.

# Postgres connection string (all services).
DATABASE_URL=postgres://skirm:skirm@localhost:5432/skirm
# Redis for BullMQ queues and pub/sub (all services).
REDIS_URL=redis://localhost:6379

# dev: trust the `x-dev-user: <handle>` header (local and judges only). privy: verify the Privy JWT.
AUTH_MODE=dev
# Privy app id and ES256 verification key (PEM); both required when AUTH_MODE=privy.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# realtime v2 brain: greedy forces the offline brain (no model calls, no spend). Anything else plays
# Haiku through OpenRouter when OPENROUTER_API_KEY is set, and greedy without it.
V2_BRAIN=greedy
# realtime: v2 tick in whole milliseconds, at least 50; unset means the game's 2000. Short ticks
# (e.g. 200) make local, smoke and e2e matches fast.
# V2_TICK_MS=200
# Model API key for the Haiku brain; leave unset to play offline only.
OPENROUTER_API_KEY=

# Base64 of a 32-byte key-encryption key for the skill vault (local stand-in for Cloud KMS
# `skill-prompt-kek`). DEV-ONLY KEY BELOW: it is the public built-in default (base64 of
# "skirm-dev-kek-not-for-production"). Never use it outside local dev; generate a real one with
#   openssl rand -base64 32
# Leave it empty to use SKILL_KEK_KMS instead (staging/production).
SKILL_KEK=c2tpcm0tZGV2LWtlay1ub3QtZm9yLXByb2R1Y3Rpb24=

# Cloud KMS key that wraps skill data keys when SKILL_KEK is empty (credentials via ADC; the runtime
# account needs roles/cloudkms.cryptoKeyEncrypterDecrypter on the key), e.g.
#   projects/skirm-staging/locations/us-central1/keyRings/skill-vault/cryptoKeys/skill-prompt-kek
SKILL_KEK_KMS=

# NEAR network: testnet | mainnet.
NEAR_NETWORK=testnet
# Primary NEAR RPC endpoint.
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Fallback RPC endpoint (dRPC), tried after NEAR_RPC_URL.
NEAR_RPC_FALLBACK_URL=https://near-testnet.drpc.org
# Platform signer (function-call key, ed25519:<base58>). Set both or neither; unset means
# NoopRegistry / NoopMinter (results recorded locally with status `pending`).
NEAR_OPS_ACCOUNT=
NEAR_OPS_KEY=
# Contract accounts.
NEAR_CONTRACT_SKILLS=skills.playskirm.testnet
NEAR_CONTRACT_MARKET=market.playskirm.testnet
NEAR_CONTRACT_REGISTRY=registry.playskirm.testnet
NEAR_CONTRACT_DEPOSITS=deposits.playskirm.testnet
NEAR_CONTRACT_SEASONS=seasons.playskirm.testnet

# Credits per 1 NEAR deposited (testnet placeholder rate).
CREDITS_PER_NEAR=1000

# Listen ports: api REST and realtime WebSocket (path /ws).
API_PORT=4000
REALTIME_PORT=4001

# Public URLs the web app uses to reach api and realtime.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WS_URL=ws://localhost:4001/ws
# api: comma list of browser origins allowed by CORS (the web app's origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# worker + realtime: daily model spend (USD, all instances) that logs `cost_alert` at 50/80/100%. 0 = off.
# COST_ALERT_DAILY_USD=10
# api: bearer token (32+ characters) for GET /ops/stats, read by the skirm-ops dashboard. Unset: the route is off.
OPS_TOKEN=

# worker: 0 skips seeding the official market skills at boot.
# SEED_OFFICIAL_SKILLS=1
