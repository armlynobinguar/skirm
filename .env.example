# skirm environment (docs/backend-contract.md, Environment). Copy to .env and edit.
# Read by api, worker and realtime through @skirm/server loadConfig(). An empty value means unset.
# docker-compose.yml sets its own in-network values for DATABASE_URL and REDIS_URL.

# Postgres connection string (all services).
DATABASE_URL=postgres://skirm:skirm@localhost:5432/skirm
# Redis for BullMQ queues and pub/sub (all services).
REDIS_URL=redis://localhost:6379

# dev: trust the `x-dev-user: <handle>` header (local and judges only). privy: verify the Privy JWT.
AUTH_MODE=dev
# Privy app id and ES256 verification key (PEM); both required when AUTH_MODE=privy.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# v2 brain (realtime, worker, api caster): greedy forces the offline brain (no model calls, no
# spend). model (or its old name haiku) plays the model below when LLM_API_KEY is set, and greedy
# without it (a keyless local server works with V2_BRAIN=model and a local LLM_BASE_URL).
V2_BRAIN=greedy
# realtime: v2 tick in whole milliseconds, at least 50; unset means the game's 2000. Short ticks
# (e.g. 200) make local, smoke and e2e matches fast.
# V2_TICK_MS=200
# Model provider: any OpenAI-compatible chat-completions API. Examples:
#   OpenRouter (default)  https://openrouter.ai/api/v1
#   OpenAI                https://api.openai.com/v1
#   Anthropic             https://api.anthropic.com/v1   (OpenAI-compatible endpoint)
#   Groq                  https://api.groq.com/openai/v1
#   Together              https://api.together.xyz/v1
#   Ollama (local)        http://host.docker.internal:11434/v1   (LM Studio :1234, vLLM :8000)
LLM_BASE_URL=
# The provider's API key; leave unset to play offline only. OPENROUTER_API_KEY still works.
LLM_API_KEY=
# Default model id as the provider names it (default anthropic/claude-haiku-5.5, OpenRouter's id).
# It plays every agent in ranked and every agent without another pick from LLM_MODELS, and casts
# replays. LLM_PLANNER_MODEL (default LLM_MODEL) writes the crew plans.
LLM_MODEL=
# Models players may pick per agent outside ranked (ranked always plays LLM_MODEL), each scaling the
# agent's talk rate: [{"id":"openai/gpt-5-mini","label":"GPT-5 mini","rateMultiplierBps":15000}]
LLM_MODELS=
LLM_PLANNER_MODEL=
# USD per million tokens, for the daily cost monitor when the provider returns no cost (OpenRouter
# does). Unset for a non-default model: spend is recorded as 0 (logged once).
LLM_PRICE_INPUT_USD=
LLM_PRICE_OUTPUT_USD=
# worker: HMAC key that picks each skill's hidden benchmark seeds (default skirm-bench, which is
# public). Set a private one in any shared environment so writers cannot tune for the seeds.
# BENCH_SECRET=

# Base64 of a 32-byte key-encryption key for the skill vault (local stand-in for Cloud KMS
# `skill-prompt-kek`). DEV-ONLY KEY BELOW: it is the public built-in default (base64 of
# "skirm-dev-kek-not-for-production"). Never use it outside local dev; generate a real one with
#   openssl rand -base64 32
# Leave it empty to use SKILL_KEK_KMS instead (staging/production).
SKILL_KEK=c2tpcm0tZGV2LWtlay1ub3QtZm9yLXByb2R1Y3Rpb24=

# Cloud KMS key that wraps skill data keys when SKILL_KEK is empty (credentials via ADC; the runtime
# account needs roles/cloudkms.cryptoKeyEncrypterDecrypter on the key), e.g.
#   projects/skirm-staging/locations/us-central1/keyRings/skill-vault/cryptoKeys/skill-prompt-kek
SKILL_KEK_KMS=

# NEAR network: testnet | mainnet.
NEAR_NETWORK=testnet
# Primary NEAR RPC endpoint.
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Fallback RPC endpoint (dRPC), tried after NEAR_RPC_URL.
NEAR_RPC_FALLBACK_URL=https://near-testnet.drpc.org
# Platform signer: the ops account and its private key (ed25519:<base58>). The backend signs every
# contract with this one key, so on testnet it is the ops account's full-access key
# (contracts/README.md); keep its balance small. Set both or neither; unset means NoopRegistry /
# NoopMinter (results recorded locally with status `local`).
NEAR_OPS_ACCOUNT=
NEAR_OPS_KEY=
# Contract accounts.
NEAR_CONTRACT_SKILLS=skills.playskirm.testnet
NEAR_CONTRACT_MARKET=market.playskirm.testnet
NEAR_CONTRACT_REGISTRY=registry.playskirm.testnet
NEAR_CONTRACT_DEPOSITS=deposits.playskirm.testnet
NEAR_CONTRACT_SEASONS=seasons.playskirm.testnet
# Optional (compose web build): a ranked match recorded on the registry for /verify's "Try a sample match".
SAMPLE_MATCH_ID=
# Soulbound achievement badges (code only; not deployed yet).
NEAR_CONTRACT_BADGES=badges.playskirm.testnet
# api: NEP-245 cosmetics contract (contracts/cosmetics, not deployed yet). Unset (default): skins,
# trails and nameplates are credits-only. Set, with the ops signer: bought items are minted to the
# player's linked NEAR account. Deploy it and mt_create every item first (contracts/README.md).
# NEAR_CONTRACT_COSMETICS=cosmetics.playskirm.testnet
# api: writer backing contract account (contracts/backing, not deployed yet). Set: backing runs on
# NEAR through the player's wallet. Unset: backing runs on paid credits with AUTH_MODE=dev, and is
# off (writes answer 503 backing_disabled) otherwise.
# BACKING_CONTRACT=backing.playskirm.testnet

# Agent rentals through market.rent from the renter's wallet. Off (default): paid in credits. Turn on
# only after the market is redeployed with `rent` (contracts/market/README.md).
NEAR_RENTALS_ONCHAIN=false

# Gasless onboarding (docs/gasless.md): the api relays players' first NEP-366 meta-transactions to
# skirm's contracts from this account, which pays the gas. Off until a funded relayer account is
# configured: set both or neither (the key is ed25519:<base58>; keep it in Secret Manager, never in
# a committed file). RELAYER_FREE_TXS: relayed transactions per player (default 3).
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
RELAYER_FREE_TXS=

# Credits per 1 NEAR deposited (testnet placeholder rate).
CREDITS_PER_NEAR=1000

# Listen ports: api REST and realtime WebSocket (path /ws).
API_PORT=4000
REALTIME_PORT=4001

# Public URLs the web app uses to reach api and realtime.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WS_URL=ws://localhost:4001/ws
# api: comma list of browser origins allowed by CORS (the web app's origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# api: requests per client per minute to the strict routes (NEAR RPC, paid work, sign-in, /relay)
# and to every other route.
# RATE_LIMIT_STRICT=20
# RATE_LIMIT_GENERAL=300
# api: proxies in front of the api that append to X-Forwarded-For, so the rate limiter finds the
# client address: 1 on plain Cloud Run, 2 behind an external HTTPS load balancer.
# TRUSTED_PROXY_HOPS=1

# worker + realtime: daily model spend (USD, all instances) that logs `cost_alert` at 50/80/100%. 0 = off.
# COST_ALERT_DAILY_USD=10
# api: bearer token (32+ characters) for GET /ops/stats, read by the skirm-ops dashboard. Unset: the route is off.
OPS_TOKEN=

# worker: 0 skips seeding the official market skills at boot.
# SEED_OFFICIAL_SKILLS=1
# worker: on shutdown, milliseconds to wait for active jobs before forcing the connections closed.
# WORKER_SHUTDOWN_GRACE_MS=30000
# api: daily challenge attempts per account per UTC day (failed and unpaid attempts do not count).
# DAILY_ATTEMPTS=3

# worker, api: Elo decay of inactive Diamond and Master players: days without a ranked match before
# each step, and the Elo a step takes (never below the tier floor). 0 turns it off.
# RANKED_DECAY_DAYS=14
# RANKED_DECAY_AMOUNT=25
