{
  "name": "skirm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch {}\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "smoke": "bash scripts/smoke-stack.sh",
    "test:scripts": "vitest run --config scripts/vitest.config.ts --passWithNoTests",
    "typecheck:scripts": "tsc --noEmit -p scripts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.19.1"
}
