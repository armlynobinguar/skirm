# apps/web public config (inlined at build time; restart `next dev` / rebuild after a change).
# Public origin of the site (canonical URLs, link previews, sitemap).
NEXT_PUBLIC_SITE_URL=https://playskirm.xyz
# REST api (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:4000
# WebSocket (apps/realtime).
NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws
# dev: sign in with a handle (x-dev-user), deposits and purchases use dev: receipts, no wallet.
# privy: Privy sign-in (Google / email) and a real NEAR wallet (NEAR Connect) for money.
NEXT_PUBLIC_AUTH_MODE=dev
# privy mode: the Privy app id (same app as the api's PRIVY_APP_ID); client id is optional.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# NEAR network and contract accounts the wallet calls (must match the api's NEAR_CONTRACT_*).
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Read-only NEAR JSON-RPC (header NEAR balance). Default: FastNEAR for the network.
# NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_NEAR_CONTRACT_SKILLS=skills.playskirm.testnet
NEXT_PUBLIC_NEAR_CONTRACT_MARKET=market.playskirm.testnet
NEXT_PUBLIC_NEAR_CONTRACT_DEPOSITS=deposits.playskirm.testnet
NEXT_PUBLIC_NEAR_CONTRACT_REGISTRY=registry.playskirm.testnet
# Optional: a ranked match recorded on the registry, for /verify's "Try a sample match" button.
# Unset: the button is hidden (no public api lists ended ranked matches to pick one from).
# NEXT_PUBLIC_SAMPLE_MATCH_ID=mat_…
# Zama Protocol (FHEVM on Sepolia): confidential cSKIRM credits and games. Off unless 1/true.
NEXT_PUBLIC_ZAMA_ENABLED=
# Optional overrides (defaults: packages/fhevm/deployments/sepolia.json via @skirm/fhevm/generated).
# NEXT_PUBLIC_ZAMA_CREDITS_ADDRESS=0x…
# NEXT_PUBLIC_ZAMA_MATCH_ADDRESS=0x…
# NEXT_PUBLIC_ZAMA_FOG_ADDRESS=0x…
# NEXT_PUBLIC_ZAMA_AUCTION_ADDRESS=0x…
# NEXT_PUBLIC_ZAMA_BENCHMARK_ADDRESS=0x…
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Where /verify's SkirmMatch event scan starts (default: the deploy block in deployments/sepolia.json).
# NEXT_PUBLIC_ZAMA_MATCH_FROM_BLOCK=
# Minimum cSKIRM stake per side of a sealed match this client creates (whole cSKIRM; default 10,
# 0 makes sealed matches unstaked). Both players' builds should agree.
# NEXT_PUBLIC_ZAMA_MIN_STAKE=10
