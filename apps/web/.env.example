# apps/web public config (inlined at build time; restart `next dev` / rebuild after a change).
# Public origin of the site (canonical URLs, link previews, sitemap).
NEXT_PUBLIC_SITE_URL=https://playskirm.xyz
# REST api (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:4000
# WebSocket (apps/realtime).
NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws
# dev: sign in with a handle (x-dev-user), deposits and purchases use dev: receipts, no wallet.
# privy: Privy sign-in (Google / email) and a real NEAR wallet (NEAR Connect) for money.
NEXT_PUBLIC_AUTH_MODE=dev
# privy mode: the Privy app id (same app as the api's PRIVY_APP_ID); client id is optional.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# NEAR network and contract accounts the wallet calls (must match the api's NEAR_CONTRACT_*).
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Read-only NEAR JSON-RPC (header NEAR balance). Default: FastNEAR for the network.
# NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_NEAR_CONTRACT_SKILLS=skills.playskirm.testnet
NEXT_PUBLIC_NEAR_CONTRACT_MARKET=market.playskirm.testnet
NEXT_PUBLIC_NEAR_CONTRACT_DEPOSITS=deposits.playskirm.testnet
NEXT_PUBLIC_NEAR_CONTRACT_REGISTRY=registry.playskirm.testnet
